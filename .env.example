# Copy to .env for local development. Replace placeholders; never commit secrets.
NODE_ENV=development
PORT=4000
# Use Atlas (a replica set). URL-encode special characters in URI credentials.
# Alternatively, use an already initialized local replica set:
# MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/
# Separate names: doctor_tracker_development, doctor_tracker_test, doctor_tracker_demo
# Automated tests use a disposable MongoMemoryReplSet, never this database.
MONGODB_DATABASE=doctor_tracker_development
# Optional: only if the local DNS resolver cannot resolve Atlas SRV/TXT records.
# DNS_SERVERS=1.1.1.1,8.8.8.8
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# Exact frontend origin without a path or trailing slash; use HTTPS in production.
FRONTEND_ORIGIN=http://localhost:3000
# false for direct access; use an explicit proxy IP/CIDR list behind a reverse proxy.
# Example for a local proxy only: loopback
TRUST_PROXY=false
LOG_LEVEL=info
# Provisioning only; supply ADMIN_NAME, ADMIN_EMAIL, ADMIN_PASSWORD temporarily.
# Fixtures are opt-in. See docs/data-and-performance.md for guarded commands.
# FIXTURE_DATABASE=doctor_tracker_development
# SEED_DEMO=true
# DEMO_ADMIN_EMAIL, DEMO_ADMIN_PASSWORD
# DEMO_DOCTOR_EMAIL, DEMO_DOCTOR_PASSWORD
# DEMO_PATIENT_EMAIL, DEMO_PATIENT_PASSWORD
# PERF_DOCTORS=100
# PERF_PATIENTS=10000
# HTTPS acceptance client: see docs/deployment.md. Never commit its credentials.
# SMOKE_BASE_URL=https://YOUR-SERVICE.onrender.com
# SMOKE_ORIGIN=https://YOUR-ALLOWED-ORIGIN.example
# SMOKE_ALLOW_WRITES=true
# SMOKE_ADMIN_EMAIL, SMOKE_ADMIN_PASSWORD, SMOKE_FIXTURE_PASSWORD

# Optional Google Sign-In. Set both values in the backend .env only.
# Register FRONTEND_ORIGIN/api/v1/auth/google/callback in Google Cloud.
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
