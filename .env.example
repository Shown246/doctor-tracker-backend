NODE_ENV=development
PORT=4000
# Use Atlas (a replica set). Never commit a working URI.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/
# Separate names: doctor_tracker_development, doctor_tracker_test, doctor_tracker_demo
# Automated tests use a disposable MongoMemoryReplSet, never this database.
MONGODB_DATABASE=doctor_tracker_development
# Optional: only if the local DNS resolver cannot resolve Atlas SRV/TXT records.
# DNS_SERVERS=1.1.1.1,8.8.8.8
SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://localhost:3000
# false for direct access; use an explicit proxy IP/CIDR list behind a reverse proxy.
# Example for a local proxy only: loopback
TRUST_PROXY=false
LOG_LEVEL=info
# Provisioning only; supply ADMIN_NAME, ADMIN_EMAIL, ADMIN_PASSWORD temporarily.
